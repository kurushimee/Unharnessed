{
  "name": "kuru-code",
  "productName": "kuru code",
  "version": "0.1.0",
  "description": "kuru code: a desktop app for the Unharnessed agent, its interface taken from T3 Code.",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.cjs",
  "author": "kurushimee",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "node scripts/start.mjs",
    "dist": "node scripts/build.mjs && node scripts/dist.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-pacer": "^0.19.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^24.12.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "effect": "^4.1.2",
    "electron": "44.10.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.564.0",
    "oxc-transform-react": "^0.152.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "use-sync-external-store": "^1.7.0",
    "vite": "^8.0.0",
    "zustand": "^5.0.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "dev.kuru.code",
    "productName": "kuru code",
    "executableName": "kuru-code",
    "copyright": "kurushimee",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "kuru code",
      "uninstallDisplayName": "kuru code",
      "artifactName": "kuru-code-setup-${version}.exe",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
