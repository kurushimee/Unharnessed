{
  "name": "kuru-code",
  "productName": "kuru code",
  "version": "0.1.0",
  "description": "kuru code: a desktop app for the Unharnessed agent, its interface taken from T3 Code.",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.cjs",
  "author": "kurushimee",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "node scripts/start.mjs",
    "dist": "node scripts/build.mjs && node scripts/dist.mjs",
    "postinstall": "node scripts/apply-patches.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/atom-react": "^4.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@legendapp/list": "^3.7.2",
    "@pierre/diffs": "^1.7.0-beta.3",
    "@pierre/trees": "^1.0.0-beta.6",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-pacer": "^0.19.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/culori": "^4.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.12.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "culori": "^4.0.2",
    "dompurify": "^3.4.18",
    "effect": "^4.1.2",
    "electron": "44.10.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "hast-util-to-html": "^9.0.6",
    "lucide-react": "^0.564.0",
    "oxc-transform-react": "^0.152.0",
    "pele": "^1.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "unbash": "^5.1.0",
    "use-sync-external-store": "^1.7.0",
    "vite": "^8.0.0",
    "zustand": "^5.0.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "dev.kuru.code",
    "productName": "kuru code",
    "executableName": "kuru-code",
    "copyright": "kurushimee",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "kuru code",
      "uninstallDisplayName": "kuru code",
      "artifactName": "kuru-code-setup-${version}.exe",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@betteroffice/docx": "^0.4.3",
    "@betteroffice/fonts": "^0.4.0",
    "@betteroffice/pptx": "^0.2.0",
    "@betteroffice/xlsx": "^0.3.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-blockquote": "^3.34.0",
    "@tiptap/extension-bold": "^3.34.0",
    "@tiptap/extension-code": "^3.34.0",
    "@tiptap/extension-code-block": "^3.34.0",
    "@tiptap/extension-heading": "^3.34.0",
    "@tiptap/extension-horizontal-rule": "^3.34.0",
    "@tiptap/extension-italic": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-strike": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "fast-xml-parser": "^5.7.3",
    "heic-to": "^1.6.7",
    "jszip": "^3.10.1",
    "mdast-util-directive": "^3.2.0",
    "mermaid": "^12.3.0",
    "micromark-extension-directive": "^4.0.0",
    "pdfjs-dist": "^6.4.299",
    "saxes": "^6.0.0",
    "sql.js": "^1.15.0",
    "tiff": "^7.1.3"
  },
  "overrides": {
    "remark-math": {
      "micromark-extension-math": "npm:micromark-extension-llm-math@3.1.0"
    },
    "micromark-extension-gfm-table": "2.1.1",
    "micromark": "4.0.2",
    "mdast-util-to-hast": "13.2.1"
  }
}
