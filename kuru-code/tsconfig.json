{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "noUncheckedIndexedAccess": false,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/renderer/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@panel/*": [
        "../vscode/webview/*"
      ],
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom": [
        "node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src/renderer",
    "src/shared",
    "../vscode/webview/env.d.ts"
  ]
}